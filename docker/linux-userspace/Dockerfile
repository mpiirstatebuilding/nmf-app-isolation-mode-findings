# Testbed image for appsIsolation=linux-userspace (findings 1 and 6).
#
# Deliberately NOT a copy of the source project's bench_isolation.sh
# Dockerfile-patching approach (see docs/MIGRATION_TO_TESTBED.md section 2)
# -- authored fresh for this testbed's narrower need: a Supervisor container
# that can actually run linux-userspace mode's adduser()/su-based App
# launch, which needs sudo + an admin account configured by the generated
# filesystem's own setup_linux_userspace.sh (not just the plain slim runtime
# image the other three modes use).
#
# Base is eclipse-temurin:21-jre -- a stock Debian/Ubuntu-based image (not
# Alpine), which is finding 6's own host requirement, and incidentally also
# the base finding 7 needs (unrelated finding, same base image).
#
# Build context must be the generated filesystem's parent directory (i.e.
# barebone-space-filesystem/target/space-filesystem), with any .nmfpack test
# packages already copied into nanosat-mo-framework/packages/ beforehand --
# see the finding's own README for the exact commands.
#
#   docker build -f docker/linux-userspace/Dockerfile \
#     -t nmf-testbed-linux-userspace:<nmf-version> \
#     <checkout>/nmf-mission-barebone/barebone-space-filesystem/target/space-filesystem

FROM eclipse-temurin:21-jre

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini sudo \
    && rm -rf /var/lib/apt/lists/*

COPY nanosat-mo-framework/ /nanosat-mo-framework/
WORKDIR /nanosat-mo-framework

# Networking note (not a workaround for any finding): default autohost
# advertises the container's own bridge IP (e.g. 172.17.0.2) as the
# Supervisor's provider URI. That's unreachable from the macOS host
# directly, but IS reachable from another container on the same bridge
# network -- so run consumers (RunAppTrigger, etc.) as containers on this
# image's network rather than forcing a loopback advertise here. A loopback
# forcing was tried and abandoned 2026-09-15: it breaks the async
# request/response path back to a host-side client (see docs/SETUP.md).

# setup_linux_userspace.sh (generated by nmf-linux-maven-plugin, not authored
# here) creates the nmf-admin account + sudoers rules + nmf-apps group this
# mode needs, and chowns packages/ (and any .nmfpack files already staged
# there by the build context) to nmf-admin -- it tolerates directories that
# already exist, so package staging can happen before or after this step.
RUN chmod +x setup_linux_userspace.sh start_supervisor.sh \
    && ./setup_linux_userspace.sh

# Infrastructure fix, NOT a workaround for finding 6: setup_linux_userspace.sh
# creates nmf-admin via plain `adduser --system --shell ... --group`, no
# --home -- the exact same Debian/Ubuntu adduser gap finding 6 reports, just
# hitting the Supervisor's own admin account instead of an App's account (a
# different call site, esa.mo.nmf.environment.LinuxUsersGroups.adduser(),
# still runs unpatched for every App account this image creates later).
# Without this, nmf-admin's home resolves to /nonexistent and the Supervisor
# can't even start (AppStorage/OneInstanceLock needs a writable home) --
# confirmed live 2026-09-15, see findings/06-adduser-no-home/README.md
# Observed notes.
RUN mkdir -p /home/nmf-admin \
    && chown nmf-admin:nmf-admin /home/nmf-admin \
    && usermod -d /home/nmf-admin nmf-admin

USER nmf-admin
EXPOSE 1024
ENTRYPOINT ["tini", "--", "./start_supervisor.sh"]
